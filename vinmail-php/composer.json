{
  "name": "vinworld/vinmail",
  "description": "Official PHP and Laravel SDK for the VinMail transactional email API.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "vinmail",
    "vinworld",
    "email",
    "transactional-email",
    "laravel",
    "mail"
  ],
  "homepage": "https://vinmail.vinworlddev.com/docs",
  "authors": [
    {
      "name": "Vinworld",
      "email": "dev@vinworlddev.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "suggest": {
    "illuminate/mail": "Enables automatic Laravel Mail driver registration (MAIL_MAILER=vinmail).",
    "symfony/mailer": "Required when using VinMailTransport with Laravel Mail."
  },
  "autoload": {
    "psr-4": {
      "VinWorld\\VinMail\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "VinWorld\\VinMail\\Laravel\\VinMailServiceProvider"
      ],
      "aliases": {
        "VinMail": "VinWorld\\VinMail\\Laravel\\Facades\\VinMail"
      }
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "minimum-stability": "stable"
}
